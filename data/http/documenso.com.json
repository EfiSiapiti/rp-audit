{
  "rp_id": "documenso.com",
  "captured_requests": 39,
  "style": "standard",
  "ajax_headers": [],
  "flow": [
    {
      "tag": "login",
      "method": "POST",
      "url": "https://app.documenso.com/api/auth/email-password/authorize",
      "status": 201,
      "request_content_type": "application/json",
      "csrf": {
        "location": "body",
        "name": "csrfToken",
        "source": "cookie:__Secure-csrfToken"
      },
      "login_fields": {
        "email": "{{email}}",
        "password": "{{password}}"
      },
      "sets_session_cookie": true
    },
    {
      "tag": "webauthn_register_begin",
      "method": "POST",
      "url": "https://app.documenso.com/api/trpc/auth.passkey.createRegistrationOptions?batch=1",
      "status": 200,
      "request_content_type": "application/json"
    },
    {
      "tag": "webauthn_register_finish",
      "method": "POST",
      "url": "https://app.documenso.com/api/trpc/auth.passkey.create?batch=1",
      "status": 200,
      "request_content_type": "application/json"
    }
  ],
  "summary": {
    "login": 1,
    "webauthn_register_begin": 1,
    "webauthn_register_finish": 1
  }
}