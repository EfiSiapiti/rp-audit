{
  "rp_id": "discord.com",
  "login_url": "https://discord.com",
  "success_url": "https://discord.com/channels/@me",
  "steps": [
    {
      "kind": "navigate",
      "url": "https://discord.com/"
    },
    {
      "kind": "click",
      "selector": "#main > div:nth-of-type(1)",
      "frame_url": "https://discord.com/",
