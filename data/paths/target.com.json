{
  "rp_id": "target.com",
  "login_url": "https://target.com",
  "success_url": "https://www.target.com/account/settings/signinsecurity",
  "steps": [
    {
      "kind": "navigate",
      "url": "https://www.target.com/"
    },
    {
      "kind": "click",
      "selector": "[data-test=\"\\@web\\/AccountLink\"]",
      "frame_url": "https://www.target.com/",
      "text": "Account"
    },
    {
      "kind": "click",
      "selector": "[data-test=\"accountNav-signIn\"]",
      "frame_url": "https://www.target.com/",
      "text": "Sign in or create account"
    },
    {
      "kind": "navigate",
      "url": "https://www.target.com/login?client_id=ecom-web-1.0.0&ui_namespace=ui-default&back_button_action=browser&keep_me_signed_in=true&kmsi_default=false&actions=create_session_request_username&signin_amr=true"
    },
    {
      "kind": "fill",
      "selector": "#username",
      "frame_url": "https://www.target.com/login?client_id=ecom-web-1.0.0&ui_namespace=ui-default&back_button_action=browser&keep_me_signed_in=true&kmsi_default=false&actions=create_session_request_username&signin_amr=true",
      "field": "email"
    },
    {
      "kind": "click",
      "selector": "#login",
      "frame_url": "https://www.target.com/login?client_id=ecom-web-1.0.0&ui_namespace=ui-default&back_button_action=browser&keep_me_signed_in=true&kmsi_default=false&actions=create_session_request_username&signin_amr=true",
      "text": "Continue"
    },
    {
      "kind": "click",
      "selector": "#otp",
      "frame_url": "https://www.target.com/login?client_id=ecom-web-1.0.0&ui_namespace=ui-default&back_button_action=browser&keep_me_signed_in=true&kmsi_default=false&actions=create_session_request_username&signin_amr=true",
      "text": "Get a code"
    },
    {
      "kind": "fill",
      "selector": "input[type=\"tel\"]",
      "frame_url": "https://www.target.com/login?client_id=ecom-web-1.0.0&ui_namespace=ui-default&back_button_action=browser&keep_me_signed_in=true&kmsi_default=false&actions=create_session_request_username&signin_amr=true",
      "field": "otp"
    },
    {
      "kind": "click",
      "selector": "#verify",
      "frame_url": "https://www.target.com/login?client_id=ecom-web-1.0.0&ui_namespace=ui-default&back_button_action=browser&keep_me_signed_in=true&kmsi_default=false&actions=create_session_request_username&signin_amr=true",
      "text": "Verify"
    },

    {
      "kind": "navigate",
      "url": "https://www.target.com/account/settings"
    },

    {
      "kind": "navigate",
      "url": "https://www.target.com/account/settings/signinsecurity"
    },
    
    {
      "kind": "click",
      "selector": "[data-test=\"addPasskeyButton\"]",
      "frame_url": "https://www.target.com/account/settings/signinsecurity",
      "text": "Add passkey"
    },
    {
      "kind": "click",
      "selector": "[data-test=\"\\@web\\/AccountLink\"]",
      "frame_url": "https://www.target.com/account/settings/signinsecurity",
      "text": "5\nHi, "
    },
    {
      "kind": "click",
      "selector": "[data-test=\"accountNav-guestSignOut\"]",
      "frame_url": "https://www.target.com/account/settings/signinsecurity",
      "text": "Sign out"
    },
    {
      "kind": "navigate",
      "url": "https://www.target.com/"
    }
    
  ]
}