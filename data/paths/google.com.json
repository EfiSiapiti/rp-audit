{
  "rp_id": "google.com",
  "login_url": "https://accounts.google.com/",
  "success_url": "https://myaccount.google.com/?utm_source=sign_in_no_continue",
  "register_url": "https://myaccount.google.com/security",
  "steps": [
    {
      "kind": "navigate",
      "url": "https://accounts.google.com/"
    },
    {
      "kind": "fill",
      "selector": "#identifierId",
      "field": "email",
      "value": "email"
    },
    {
      "kind": "click",
      "selector": "text=\"Next\"",
      "text": "Next"
    },
    
    {
      "kind": "fill",
      "selector": "input[name=\"Passwd\"]",
      "field": "password",
      "value": "password"
    },
    {
      "kind": "click",
      "selector": "text=\"Next\"",
      "text": "Next"
    },
    
    {
      "kind": "manual",
      "prompt": "Enter the OTP from your phone into the code field and click Next in the browser"
    },

  
    {
      "kind": "navigate",
      "url": "https://myaccount.google.com/security"
    },
    {
      "kind": "click",
      "selector": "text=\"Passkeys and security keys\"",
      "frame_url": "https://myaccount.google.com/security",
      "text": "Passkeys and security keys"
    },
    
    
    {
      "kind": "click",
      "selector": "text=\"Create a passkey\"",
      "frame_url": "https://myaccount.google.com/signinoptions/passkeys?utm_source=google-account&utm_medium=web&utm_campaign=passkeys-screen",
      "text": "Create a passkey"
    },
    
    {
      "kind": "click",
      "selector": "button[aria-label=\"Continue\\ passkey\\ enrollment\"]",
      "frame_url": "https://myaccount.google.com/signinoptions/passkeys?utm_source=google-account&utm_medium=web&utm_campaign=passkeys-screen",
      "text": "Create a passkey"
    },
    
    {
      "kind": "click",
      "selector": "button[aria-label=\"Close\\ passkey\\ enrollment\\ dialog\"]",
      "frame_url": "https://myaccount.google.com/signinoptions/passkeys?utm_source=google-account&utm_medium=web&utm_campaign=passkeys-screen",
      "text": "Done"
    },
    
    {
      "kind": "click",
      "selector": "a[aria-label=\"Google\\ Account\"]",
      "frame_url": "https://myaccount.google.com/signinoptions/passkeys?utm_source=google-account&utm_medium=web&utm_campaign=passkeys-screen",
      "text": ""
    },
    {
      "kind": "click",
      "selector": "text=\"Sign out\"",
      "text": "Sign out"
    }
    
  ]
}