    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/logout?post_logout_redirect_uri=https%3A%2F%2Faccounts.nintendo.com%2Fportal"
    },
    {
      "kind": "click",
      "selector": "#logout-confirm-logout",
      "frame_url": "https://accounts.nintendo.com/logout?post_logout_redirect_uri=https%3A%2F%2Faccounts.nintendo.com%2Fportal",
      "text": "Sign out"
    },
    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/login?post_login_redirect_uri=https%3A%2F%2Faccounts.nintendo.com%2Fportal"
    },
    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/portal"
