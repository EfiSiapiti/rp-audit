    },
    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/#loginSecurity"
    },
    {
      "kind": "click",
      "selector": "#account-configuration-v2-pc_loginSecurity_passkeyAction",
      "frame_url": "https://accounts.nintendo.com/#loginSecurity",
