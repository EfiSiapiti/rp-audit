      "selector": "#login-form-id",
      "frame_url": "https://accounts.nintendo.com/login",
      "field": "email"
    },
    {
      "kind": "fill",
      "selector": "#login-form-password",
      "frame_url": "https://accounts.nintendo.com/login",
      "field": "password"
    },
    {
      "kind": "click",
      "selector": "#accounts-login-button",
      "frame_url": "https://accounts.nintendo.com/login",
      "text": "Sign in"
    },
    
    {
      "kind": "fill",
      "selector": "#challenge_form_pc_input_0",
      "field": "otp"
    },
    {
      "kind": "click",
      "selector": "#challenge_form_pc_button_0",
      "text": "Verify"
    },
    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/"
    },
    {
      "kind": "click",
      "selector": "#navigation-v2-pc_loginSecurity",
      "frame_url": "https://accounts.nintendo.com/",
