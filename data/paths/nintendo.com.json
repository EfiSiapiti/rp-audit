    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/portal"
    },
    {
      "kind": "click",
      "selector": "div[aria-label=\"efisiapi\"]",
      "frame_url": "https://accounts.nintendo.com/portal",
      "text": "efisiapi"
