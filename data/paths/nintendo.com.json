    },
    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/passkey/register?from=INDEX"
    },
    {
      "kind": "click",
      "selector": "#passkey-register-form_pc_button_0",
      "frame_url": "https://accounts.nintendo.com/passkey/register?from=INDEX",
      "text": "Register Passkey"
    },
    {
      "kind": "navigate",
      "url": "https://accounts.nintendo.com/passkey/register"
    },
    {
      "kind": "click",
      "selector": "#passkey-register-complete_pc_a_0",
